# =====================================================================
# speech_n8n configuration
# Copy this file to `.env` and adjust the values for your environment.
# =====================================================================

# --- n8n webhook (REQUIRED) ------------------------------------------
# The full URL of the n8n webhook node that should receive transcriptions.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voice-agent

# --- Whisper / STT ---------------------------------------------------
# Model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Inference device: cpu | cuda | auto
DEVICE=cpu
# Compute type: int8 | int8_float16 | float16 | float32
COMPUTE_TYPE=int8
# Beam size for decoding (higher = more accurate but slower)
BEAM_SIZE=5
# Spoken language ISO code, or "auto" to let Whisper detect it.
LANGUAGE=en

# --- Voice Activity Detection ----------------------------------------
# Sample rate in Hz (Silero VAD and Whisper both expect 16000).
SAMPLE_RATE=16000
# Minimum speech duration (seconds) before an utterance is considered valid.
MIN_SPEECH_DURATION=0.25
# How long (seconds) of trailing silence ends an utterance.
SILENCE_TIMEOUT=1.5
# Hard cap on a single recording (seconds) to avoid runaway captures.
MAX_RECORDING_SECONDS=20
# Silero VAD speech probability threshold (0.0 - 1.0).
VAD_THRESHOLD=0.5

# --- Wake word (optional) --------------------------------------------
WAKEWORD_ENABLED=false
# Comma-separated openWakeWord model names, e.g. "hey_jarvis,alexa".
WAKEWORD_MODELS=hey_jarvis
# Detection threshold (0.0 - 1.0).
WAKEWORD_THRESHOLD=0.5

# --- Webhook networking ----------------------------------------------
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_BACKOFF_FACTOR=0.5

# --- Logging ---------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit logs as JSON instead of human-readable text: true | false
LOG_JSON=false

# --- Debugging -------------------------------------------------------
# Save captured utterances as WAV files under this directory (empty = off).
SAVE_AUDIO_DIR=
